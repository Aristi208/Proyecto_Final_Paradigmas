@model List<CL_Taller.CPersona.Cliente>

<h2>Clientes registrados</h2>

<a href="/Cliente/Crear">Registrar cliente</a>

@if (Model.Count == 0)
{
    <p>No hay clientes registrados.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Crédito</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Nombre</td>
                    <td>@c.Telefono</td>
                    <td>@c.Estado_credito</td>
                </tr>
            }
        </tbody>
    </table>
}