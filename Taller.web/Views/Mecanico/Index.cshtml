@model List<CL_Taller.CPersona.Mecanico>

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Mecánicos</h2>

    <a href="/Mecanico/Crear" class="btn btn-success">
        + Registrar mecánico
    </a>

</div>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">
        No hay mecánicos registrados.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Especialidad</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var m in Model)
                {
                    <tr>

                        <td>@m.Id</td>

                        <td>
                            <strong>@m.Nombre</strong>
                        </td>

                        <td>@m.Telefono</td>

                        <td>
                            <span class="badge bg-dark">
                                @m.Especialidad
                            </span>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}