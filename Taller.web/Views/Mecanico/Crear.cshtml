<h2 class="mb-4">
    Registrar mecánico
</h2>

<div class="card-custom">

    <form method="post">

        <div class="row">

            <div class="col-md-6">

                <div class="mb-3">
                    <label class="form-label">
                        ID
                    </label>

                    <input type="number"
                           name="id"
                           class="form-control"
                           placeholder="Ingrese ID" />
                </div>

            </div>

            <div class="col-md-6">

                <div class="mb-3">
                    <label class="form-label">
                        Nombre
                    </label>

                    <input type="text"
                           name="nombre"
                           class="form-control"
                           placeholder="Nombre del mecánico" />
                </div>

            </div>

        </div>

        <div class="row">

            <div class="col-md-6">

                <div class="mb-3">
                    <label class="form-label">
                        Teléfono
                    </label>

                    <input type="number"
                           name="telefono"
                           class="form-control"
                           placeholder="3001234567" />
                </div>

            </div>

            <div class="col-md-6">

                <div class="mb-4">

                    <label class="form-label">
                        Especialidad
                    </label>

                    <select name="especialidad"
                            class="form-select">

                        @foreach (var e in ViewBag.Especialidades)
                        {
                            <option value="@e">
                                @e
                            </option>
                        }

                    </select>

                </div>

            </div>

        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-success">

                Registrar mecánico
            </button>

            <a href="/Mecanico"
                   class="btn btn-outline-secondary">

                Volver
            </a>

        </div>

    </form>

</div>