@model List<CL_Taller.CReparacion.Reparacion>

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Reparaciones</h2>

    <a href="/Reparacion/Crear" class="btn btn-primary">
        + Nueva reparación
    </a>

</div>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">
        No hay reparaciones registradas.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Vehículo</th>
                    <th>Fecha</th>
                    <th>Mecánicos</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>

                        <td>
                            <strong>
                                @Model[i].Vehiculo
                            </strong>
                        </td>

                        <td>
                            @Model[i].Fecha.ToString("dd/MM/yyyy")
                        </td>

                        <td>

                            @if (Model[i].L_mecanicos != null &&
                                                       Model[i].L_mecanicos.Count > 0)
                            {
                                @foreach (var m in Model[i].L_mecanicos)
                                {
                                    <span class="badge bg-secondary mb-1">
                                        @m.Nombre
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    Sin mecánicos
                                </span>
                            }

                        </td>

                        <td>

                            @if (Model[i].Rep_terminada)
                            {
                                <span class="badge-status success">
                                    Terminada
                                </span>
                            }
                            else
                            {
                                <span class="badge-status danger">
                                    En proceso
                                </span>
                            }

                        </td>

                        <td>

                            <div class="d-flex gap-2">



                                    <a href="/Reparacion/Detalle?placa=@Model[i].Vehiculo.Placa"
                                        class="btn btn-dark btn-sm">

                                        <i class="bi bi-eye-fill"></i>
                                        Ver detalle

                                    </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}