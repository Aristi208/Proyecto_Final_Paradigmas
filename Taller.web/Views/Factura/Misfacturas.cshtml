@model List<CL_Taller.CPago.Factura>

<h2>Mis Facturas</h2>

@if (Model.Count == 0)
{
    <p>No tienes facturas registradas.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Total</th>
                <th>Tipo pago</th>
                <th>Pagada</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in Model)
            {
                <tr>
                    <td>$@f.Total</td>
                    <td>@f.TipoPago</td>
                    <td>@f.Pagada</td>
                </tr>
            }
        </tbody>
    </table>
}

<a href="/Vehiculo/MisVehiculos">Volver a mis vehículos</a>