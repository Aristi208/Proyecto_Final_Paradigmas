@model List<CL_Taller.CPago.Factura>

<h2 class="mb-4">
    Facturas
</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">
        No hay facturas registradas.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Total</th>
                    <th>Pago</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>

            <tbody>

                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>

                        <td>
                            <strong>
                                @Model[i].Cliente.Nombre
                            </strong>
                        </td>

                        <td>
                            <span class="fw-bold text-success">
                                $@Model[i].Total
                            </span>
                        </td>

                        <td>
                            @Model[i].TipoPago
                        </td>

                        <td>

                            @if (Model[i].Pagada)
                            {
                                <span class="badge-status success">
                                    Pagada
                                </span>
                            }
                            else
                            {
                                <span class="badge-status danger">
                                    Pendiente
                                </span>
                            }

                        </td>

                        <td>

                            @if (!Model[i].Pagada)
                            {
                                <a href="/Factura/Pagar?placa=@Model[i].Reparacion.Vehiculo.Placa"
                                       class="btn btn-dark btn-sm">

                                    Procesar pago
                                </a>
                                <a href="/Factura/Detalle?placa=@Model[i].Reparacion.Vehiculo.Placa" class="btn btn-outline-dark btn-sm">
                                    
                                    Ver detalle
                                </a>
                            }
                            else
                            {
                                <span class="text-success fw-bold">
                                    ✔️ Completado
                                </span>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}