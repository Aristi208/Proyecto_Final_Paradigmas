@model List<CL_Taller.CPago.Factura>

<h2>Facturas</h2>

@if (Model.Count == 0)
{
    <p>No hay facturas registradas.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Total</th>
                <th>Tipo pago</th>
                <th>Pagada</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>@Model[i].Cliente.Nombre</td>
                    <td>$@Model[i].Total</td>
                    <td>@Model[i].TipoPago</td>
                    <td>@Model[i].Pagada</td>
                    <td>
                        @if (!Model[i].Pagada)
                        {
                            <a href="/Factura/Pagar/@i">Pagar</a>
                        }
                        else
                        {
                            <span>✔️ Pagada</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}