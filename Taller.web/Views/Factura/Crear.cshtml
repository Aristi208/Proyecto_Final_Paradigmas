<h2 class="mb-4">
    Nueva factura
</h2>

<div class="card-custom">

    <form method="post">

        <div class="mb-4">

            <label class="form-label">
                Reparación
            </label>

            <select name="indexReparacion"
                    class="form-select">

                @for (int i = 0;
                               i < ViewBag.Reparaciones.Count;
                               i++)
                {
                    <option value="@i">

                        @ViewBag.Reparaciones[i].Vehiculo.Placa
                        -
                        @ViewBag.Reparaciones[i].Fecha.ToString("dd/MM/yyyy")

                    </option>
                }

            </select>

        </div>

        <div class="mb-4">

            <label class="form-label">
                Cliente
            </label>

            <select name="idCliente"
                    class="form-select">

                @foreach (var c in ViewBag.Clientes)
                {
                    <option value="@c.Id">
                        @c.Nombre
                    </option>
                }

            </select>

        </div>

        <button type="submit"
                class="btn btn-dark">

            Generar factura
        </button>

    </form>

</div>