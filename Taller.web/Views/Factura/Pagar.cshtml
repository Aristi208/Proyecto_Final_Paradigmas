<h2 class="mb-4">
    Procesar pago
</h2>

<div class="card-custom" style="max-width:500px;">

    <form method="post"
          action="/Factura/ProcesarPago">

        <input type="hidden"
               name="placa"
               value="@ViewBag.Placa" />

        <div class="mb-4">

            <label class="form-label">
                Tipo de pago
            </label>

            <select name="tipoPago"
                    class="form-select">

                <option value="Contado">
                    Contado
                </option>

                <option value="Debito">
                    Tarjeta débito
                </option>

                <option value="Credito">
                    Crédito
                </option>

            </select>

        </div>

        <button type="submit"
                class="btn btn-success w-100">

            Confirmar pago
        </button>

    </form>

</div>

<div class="mt-3">

    <a href="/Factura"
           class="btn btn-outline-secondary">

        Volver
    </a>

</div>