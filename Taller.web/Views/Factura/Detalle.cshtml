@{
    var factura = ViewBag.Factura as CL_Taller.CPago.Factura;
}

<h2 class="mb-4">Detalle de Factura</h2>

<div class="card-custom mb-4">
    <div class="row">
        <div class="col-md-6">
            <h4>👤 Datos del cliente</h4>
            <p><strong>Nombre:</strong> @factura.Cliente.Nombre</p>
            <p><strong>ID:</strong> @factura.Cliente.Id</p>
            <p><strong>Teléfono:</strong> @factura.Cliente.Telefono</p>
        </div>
        <div class="col-md-6">
            <h4>🚗 Datos del vehículo</h4>
            <p><strong>Placa:</strong> @factura.Reparacion.Vehiculo.Placa</p>
            <p><strong>Marca:</strong> @factura.Reparacion.Vehiculo.Marca</p>
            <p><strong>Modelo:</strong> @factura.Reparacion.Vehiculo.Modelo</p>
            <p><strong>Año:</strong> @factura.Reparacion.Vehiculo.Ano</p>
        </div>
    </div>
</div>

<div class="card-custom mb-4">
    <h4>👨‍🔧 Mecánicos asignados</h4>
    @if (factura.Reparacion.L_mecanicos != null && factura.Reparacion.L_mecanicos.Count > 0)
    {
        <ul class="list-group">
            @foreach (var m in factura.Reparacion.L_mecanicos)
            {
                <li class="list-group-item">
                    <strong>@m.Nombre</strong>
                    <span class="badge bg-dark float-end">@m.Especialidad</span>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">Sin mecánicos asignados.</p>
    }
</div>

<div class="card-custom mb-4">
    <h4>🛠️ Procesos realizados</h4>
    @if (factura.Reparacion.Arreglos != null && factura.Reparacion.Arreglos.Count > 0)
    {
        <ul class="list-group">
            @foreach (var a in factura.Reparacion.Arreglos)
            {
                <li class="list-group-item">✅ @a</li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">Sin procesos registrados.</p>
    }
</div>

<div class="card-custom mb-4">
    <h4>💳 Información de pago</h4>
    <p><strong>Tipo de pago:</strong> @factura.TipoPago</p>
    <p>
        <strong>Estado:</strong>
        @if (factura.Pagada)
        {
            <span class="badge-status success">Pagada</span>
        }
        else
        {
            <span class="badge-status danger">Pendiente</span>
        }
    </p>
    <h4 class="text-success">Total: $@factura.Total</h4>
</div>

<a href="/Factura" class="btn btn-outline-secondary">Volver</a>