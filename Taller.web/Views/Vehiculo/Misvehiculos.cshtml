@model List<CL_Taller.CVehiculo.Vehiculo>

<h2 class="mb-4">Mis Vehículos</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">
        No tienes vehículos registrados.
    </div>
}
else
{
    <div class="row">

        @foreach (var v in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card-custom h-100">

                    <h4 class="mb-3">
                        🚗 @v.Placa
                    </h4>

                    <p><strong>Marca:</strong> @v.Marca</p>

                    <p><strong>Modelo:</strong> @v.Modelo</p>

                    <p><strong>Año:</strong> @v.Ano</p>

                </div>

            </div>
        }

    </div>
}

<a href="/Factura/MisFacturas"
       class="btn btn-dark">
    Ver mis facturas
</a>