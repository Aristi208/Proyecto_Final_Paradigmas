@model List<CL_Taller.CVehiculo.Vehiculo>

<h2>Vehículos registrados</h2>

<a href="/Vehiculo/Crear">Nueva vehiculo</a>

@if (Model.Count == 0)
{
    <p>No hay vehículos registrados.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Placa</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Año</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td>@v.Placa</td>
                    <td>@v.Marca</td>
                    <td>@v.Modelo</td>
                    <td>@v.Ano</td>
                </tr>
            }
        </tbody>
    </table>
}